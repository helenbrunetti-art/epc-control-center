# Banco de dados
DATABASE_URL=postgresql://epc_user:senha_forte@localhost:5432/epc_control_center
PGSSL=false

# Autenticação
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Servidor
PORT=4000
NODE_ENV=development
# App agora é servido na mesma origem (frontend + API no mesmo processo),
# então CORS não é mais estritamente necessário. Deixe "*" ou restrinja
# ao seu domínio final por camada extra de segurança.
CORS_ORIGIN=*

# Convite/registro
# Se definido, cadastro exige esse código (uso interno da empresa)
REGISTRATION_INVITE_CODE=

# Claude API (proxy do chat com os agentes)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Armazenamento de documentos enviados
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
